#include <stdio.h>

int main()
{
    int a[100], n, pos, item, i;

    printf("Enter the size of array: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    printf("Enter element to insert: ");
    scanf("%d", &item);

    printf("Enter position to insert: ");
    scanf("%d", &pos);

    if(pos < 1 || pos > n + 1)
    {
        printf("Invalid position");
    }
    else
    {
        for(i = n - 1; i >= pos - 1; i--)
        {
            a[i + 1] = a[i];
        }

        a[pos - 1] = item;
        n++;

        printf("Array after insertion:\n");
        for(i = 0; i < n; i++)
        {
            printf("%d ", a[i]);
        }
    }

    return 0;
}
