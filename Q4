#include <stdio.h>
#include <string.h>

int main()
{
    char str[100], stack[100];
    int top = -1, i;

    printf("Enter a string: ");
    scanf("%s", str);

    // Push characters into stack
    for(i = 0; str[i] != '\0'; i++)
    {
        stack[++top] = str[i];
    }

    // Pop characters to reverse the string
    printf("Reversed string: ");

    while(top != -1)
    {
        printf("%c", stack[top--]);
    }

    return 0;
}
